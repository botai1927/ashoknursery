# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional backup Gemini API keys configured via Settings > Secrets for automatic 429 quota rotation
GEMINI_API_KEY_BACKUP=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""

# Optional xAI Grok API key configured via Settings > Secrets (either XAI_API_KEY or GROK_API_KEY works)
XAI_API_KEY=""
GROK_API_KEY=""

# Cloudinary server-side credentials (configure in Cloud Run / Secret Manager; never commit real values)
CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="MY_CLOUDINARY_API_SECRET"

# Firebase project override (defaults to firebase-applet-config.json projectId when unset)
FIREBASE_PROJECT_ID="hidden-catalyst-7ln7n"

# Preferred on Cloud Run: attach a dedicated runtime service account with roles/firebaseauth.viewer
# on the target Firebase project and identitytoolkit.googleapis.com enabled (no static JSON needed).
# Optional Secret Manager fallback only when cross-project ADC is unavailable:
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Admin & Owner email allowlists (comma-separated lowercase emails configured via Secrets)
ADMIN_OWNER_EMAILS="owner@example.com"
ADMIN_AUTHORIZED_EMAILS="owner@example.com,manager@example.com"

# Zero-billing anti-bot challenge secret (optional; auto-generated securely at startup if unset)
PUBLIC_CHALLENGE_SECRET=""

# Optional Firebase App Check (only if you already have an App Check site key configured)
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
